# ==========================================
#  ENTRADA PERSONALIZADA DE X E Y
# ==========================================
pedir_xy() {
  echo ""
  echo -e "${AMARELO_LACO}🎀 SENSIBILIDADE DOS EIXOS X E Y 🎀${NC}"
  read -p "   🎀 Digite a sensibilidade do Eixo X: " VAL_X
  read -p "   🎀 Digite a sensibilidade do Eixo Y: " VAL_Y
  
  VAL_X=${VAL_X:-1000}
  VAL_Y=${VAL_Y:-1000}

  setprop debug.touch.x_multiplier "$VAL_X" > /dev/null 2>&1
  setprop debug.touch.y_multiplier "$VAL_Y" > /dev/null 2>&1
  setprop persist.sys.input.x_scale "$VAL_X" > /dev/null 2>&1
  setprop persist.sys.input.y_scale "$VAL_Y" > /dev/null 2>&1
  setprop debug.touch.aim_lock_xy 1 > /dev/null 2>&1
}

