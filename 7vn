#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
#  INSTALAÇÃO DE DEPENDÊNCIAS (COM CHAFA)
# ==========================================
command -v curl >/dev/null 2>&1 || pkg install curl -y >/dev/null 2>&1
command -v mpv >/dev/null 2>&1 || pkg install mpv -y >/dev/null 2>&1
command -v chafa >/dev/null 2>&1 || pkg install chafa -y >/dev/null 2>&1

# ==========================================
#  BAIXAR IMAGEM LOCAL SE NÃO EXISTIR
# ==========================================
LOCAL_IMG="$HOME/.hello_kitty_banner.jpeg"
if [ ! -f "$LOCAL_IMG" ]; then
  curl -sL "https://files.catbox.moe/j76wht.jpeg" -o "$LOCAL_IMG" >/dev/null 2>&1
fi

# ==========================================
#  REPRODUTOR DE MÚSICA DE FUNDO
# ==========================================
URL_MUSICA="https://files.catbox.moe/sa2s9b.mp3"
if [ -n "$URL_MUSICA" ]; then
  mpv --no-video --loop-file=inf --volume=40 "$URL_MUSICA" > /dev/null 2>&1 &
  MUSICA_PID=$!
fi

limpar_temp() {
  if [ -n "$MUSICA_PID" ] && kill -0 "$MUSICA_PID" 2>/dev/null; then
    kill "$MUSICA_PID" 2>/dev/null
  fi
}
trap limpar_temp EXIT INT TERM

# ==========================================
#  PALETA DE CORES
# ==========================================
R='\033[38;2;255;20;147m'
RP='\033[38;2;255;105;180m'
RF='\033[38;2;255;182;193m'
RM='\033[38;2;255;0;128m'
AM='\033[38;2;255;215;0m'
NC='\033[0m'

KEY_FILE="$TMPDIR/.hello_kitty_vip.key"
CHAVE_VALIDA="7VN-KITTY-VIP"

pedir_xy() {
  echo ""
  echo -e "${AM}🎀 SENSIBILIDADE DOS EIXOS X E Y 🎀${NC}"
  read -p "   🎀 Digite a sensibilidade do Eixo X: " VAL_X
  read -p "   🎀 Digite a sensibilidade do Eixo Y: " VAL_Y
  
  VAL_X=${VAL_X:-1000}
  VAL_Y=${VAL_Y:-1000}

  setprop debug.touch.x_multiplier "$VAL_X" > /dev/null 2>&1
  setprop debug.touch.y_multiplier "$VAL_Y" > /dev/null 2>&1
  setprop persist.sys.input.x_scale "$VAL_X" > /dev/null 2>&1
  setprop persist.sys.input.y_scale "$VAL_Y" > /dev/null 2>&1
  setprop debug.touch.aim_lock_xy 1 > /dev/null 2>&1
}

verificar_licenca() {
  clear
  echo -e "${R}  VERIFICANDO REGISTRO VIP ULTRA... 🎀${NC}"
  sleep 1
}
verificar_licenca

# ==========================================
#  EXIBIR CABEÇALHO COM A IMAGEM REAL
# ==========================================
exibir_cabecalho() {
  clear
  
  # Renderiza a imagem real usando o chafa do arquivo local
  if [ -f "$LOCAL_IMG" ]; then
    chafa --size=35x12 "$LOCAL_IMG" 2>/dev/null
    echo ""
  fi

  echo -e "${RP}      /\_/\   ${AM}🎀 7VN OPTIMIZER VIP - HELLO KITTY EDITION 🎀${NC}"
  echo -e "${RP}     ( o.o )  ${RF}=================================================${NC}"
  echo -e "${RP}      > ^ <   ${RM}TikTok: 7vn&120hz${NC}"
  echo ""
}

# ==========================================
#  MENU PRINCIPAL
# ==========================================
while true; do
  exibir_cabecalho

  echo -e "${R}┌──────────────────────────────────────────────────────────┐${NC}"
  echo -e "${R}│                 🎀 PAINEL DE OTIMIZAÇÕES VIP 🎀          │${NC}"
  echo -e "${R}└──────────────────────────────────────────────────────────┘${NC}"
  echo -e "${RP}   [1]${NC} ${RF} Modo Emulador (Com X e Y) 🎀${NC}"
  echo -e "${RP}   [2]${NC} ${RF} 7VN Injetor Touch 🎀${NC}"
  echo -e "${RP}   [3]${NC} ${RF} Mouse Easy (Com X e Y) 🎀${NC}"
  echo -e "${RP}   [4]${NC} ${RF} Zero Delay Touch 🎀${NC}"
  echo -e "${RP}   [5]${NC} ${RF} Aceleração de Eixos (100 Códigos) 🎀${NC}"
  echo -e "${RP}   [6]${NC} ${R} 7VN Segredinho VIP 🎀${NC}"
  echo -e "${RP}   [7]${NC} ${AM} Unlock 120 FPS 🎀${NC}"
  echo -e "${RP}   [8]${NC} ${RF} Sair 🎀${NC}"
  echo ""

  read -p "   🎀 Escolha uma opção [1-8]: " opcao

  case $opcao in
    1)
      pedir_xy
      setprop debug.hwui.renderer skiavk > /dev/null 2>&1
      setprop windowsmgr.max_events_per_sec 240 > /dev/null 2>&1
      echo -e "${RP}🎀 Modo Emulador configurado com sucesso! 🎀${NC}"
      ;;
    2)
      settings put system peak_refresh_rate 120.0 > /dev/null 2>&1
      settings put system min_refresh_rate 120.0 > /dev/null 2>&1
      setprop debug.performance.touch 1 > /dev/null 2>&1
      echo -e "${RP}🎀 7VN Injetor Touch ativado! 🎀${NC}"
      ;;
    3)
      pedir_xy
      setprop debug.touch.mouse_easy 1 > /dev/null 2>&1
      settings put system pointer_speed 7 > /dev/null 2>&1
      echo -e "${RP}🎀 Mouse Easy calibrado! 🎀${NC}"
      ;;
    4)
      setprop debug.performance.touch 1 > /dev/null 2>&1
      setprop ro.input.noresample 1 > /dev/null 2>&1
      setprop view.touch_slop 2 > /dev/null 2>&1
      echo -e "${RP}🎀 Touch Zero Delay applied! 🎀${NC}"
      ;;
    5)
      setprop persist.sys.input.x.speed max > /dev/null 2>&1
      setprop persist.sys.input.y.speed max > /dev/null 2>&1
      setprop debug.touch.accel_x 999 > /dev/null 2>&1
      setprop debug.touch.accel_y 999 > /dev/null 2>&1
      setprop debug.touch.accel_factor 10 > /dev/null 2>&1
      setprop persist.sys.touch.rate 240 > /dev/null 2>&1
      setprop persist.sys.touch.response 1 > /dev/null 2>&1
      setprop persist.sys.touch.sensitivity 100 > /dev/null 2>&1
      echo -e "${RP}🎀 Aceleração de eixos ativada! 🎀${NC}"
      ;;
    6)
      setprop debug.sf.fps 144 > /dev/null 2>&1
      setprop persist.sys.ff.vip_mode 1 > /dev/null 2>&1
      echo -e "${RP}🎀 Segredinho VIP 7VN ativado! 🎀${NC}"
      ;;
    7)
      setprop persist.sys.ff_unlock_ultra_fps 1 > /dev/null 2>&1
      settings put system peak_refresh_rate 120.0 > /dev/null 2>&1
      settings put system min_refresh_rate 120.0 > /dev/null 2>&1
      echo -e "${RP}🎀 Unlock 120 FPS aplicado com sucesso! 🎀${NC}"
      ;;
    8)
      echo -e "${RP}Saindo... Siga no TikTok: 7vn&120hz 🎀${NC}"
      exit 0
      ;;
    *)
      echo -e "${R}Opção inválida!${NC}"
      ;;
  esac

  echo ""
  read -p "Pressione [Enter] para voltar ao menu..."
done

